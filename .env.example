# Copia este archivo como .env y completa los valores reales.
PORT=3000
NATS_SERVERS="nats://localhost:4222"

# gRPC de los microservicios internos (puertos hardcodeados en cada main.ts)
AUTH_GRPC_URL="localhost:50051"
USER_GRPC_URL="localhost:50052"
REHAB_GRPC_URL="localhost:50053"
FINANCE_GRPC_URL="localhost:50054"

# Origen permitido para CORS: el frontend en dev corre en el puerto 3002
CORS_ORIGIN="http://localhost:3002"
